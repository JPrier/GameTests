; Engine configuration file.
config_version=5

[application]

config/name="Kitchen Crawl"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

AgentBridge="*res://addons/agent_bridge/agent_bridge.gd"

[display]

